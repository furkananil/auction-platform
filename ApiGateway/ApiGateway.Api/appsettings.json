{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "super_secret_key_for_auction_microservices_2026",
    "Issuer": "AuctionIdentityService",
    "Audience": "AuctionMicroservices"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "bidding-route": {
        "ClusterId": "bidding-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "Match": {
          "Path": "/api/bids/{**catch-all}"
        }
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "auction-route": {
        "ClusterId": "auction-cluster",
        "Match": {
          "Path": "/api/auctions/{**catch-all}"
        }
      },
      "realtime-route": {
        "ClusterId": "realtime-cluster",
        "Match": {
          "Path": "/auctionhub/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5000" }
        },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": false }
      },
      "bidding-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5001" }
        },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": false }
      },
      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5009" }
        },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": false }
      },
      "ordering-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5017" }
        },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": false }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5006" }
        },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": false }
      },
      "auction-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5004" }
        },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": false }
      },
      "realtime-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5102" }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false,
          "WebSocketOptions": { "KeepAliveInterval": "00:00:30" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5008" }
        },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": false }
      }
    }
  }
}